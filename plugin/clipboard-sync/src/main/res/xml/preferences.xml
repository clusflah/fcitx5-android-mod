<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        app:key="quick_sync"
        app:iconSpaceReserved="false"
        app:title="@string/quick_sync"
        app:summary="@string/quick_sync_summary"
        app:defaultValue="true" />

    <!-- filled in by SettingsActivity: one entry per server, in priority order -->
    <PreferenceCategory
        app:key="servers"
        app:iconSpaceReserved="false"
        app:title="@string/servers_title"
        app:summary="@string/servers_summary" />

    <PreferenceCategory
        app:key="other"
        app:iconSpaceReserved="false"
        app:title="@string/other_settings">

        <EditTextPreference
            app:key="sync_interval"
            app:iconSpaceReserved="false"
            app:title="@string/sync_interval"
            app:defaultValue="3"
            app:useSimpleSummaryProvider="true" />

        <Preference
            app:key="download_path"
            app:iconSpaceReserved="false"
            app:title="@string/download_path"
            app:summary="@string/download_path_not_set" />

        <Preference
            app:key="test_connection"
            app:iconSpaceReserved="false"
            app:title="@string/test_connection"
            app:summary="@string/clicktest" />

    </PreferenceCategory>

</PreferenceScreen>
