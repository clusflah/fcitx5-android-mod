<?xml version="1.0" encoding="utf-8"?>
<!--
  All-in-one build: plain HTTP is allowed, so the built-in clipboard sync can reach a SyncClipboard
  server on the LAN (http://192.168.x.x). Requests that carry an API key (AI services, Azure speech)
  still use plain HTTP only to this phone itself, see CleartextGuard.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
