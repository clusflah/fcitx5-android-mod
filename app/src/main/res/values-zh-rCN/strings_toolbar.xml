<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="toolbar_buttons">工具栏按钮</string>
    <string name="toolbar_buttons_summary">统一设置工具栏按钮（含语音输入）的显示 / 隐藏、顺序和常驻右侧</string>
    <string name="toolbar_buttons_list_note">开关：是否显示。箭头：调整顺序（从左到右）。图钉：常驻右侧，放在收起键盘按钮左边，工具栏收起时也显示；没钉住的按钮只在展开工具栏后显示。</string>
    <string name="toolbar_button_bitwarden">Bitwarden（未安装时不显示）</string>
    <string name="toolbar_button_voice">语音输入（点一下说话，再点一下识别；密码框不显示）</string>
    <string name="toolbar_button_pin">常驻右侧</string>
    <string name="toolbar_button_unpin">取消常驻</string>
    <string name="card_style">圆形按钮与卡片式面板</string>
    <string name="floating_keyboard">悬浮键盘</string>
    <string name="toolbar_button_floating">悬浮键盘（长按重置位置和大小）</string>
    <string name="floating_keyboard_portrait">竖屏悬浮键盘</string>
    <string name="floating_keyboard_portrait_summary">竖屏时键盘悬浮在应用上方：拖动底部横条移动位置，拖动底部两角调整大小，长按工具栏悬浮按钮可重置。工具栏和“更多”面板也能随时开关</string>
    <string name="floating_keyboard_landscape">横屏悬浮键盘</string>
    <string name="floating_keyboard_landscape_summary">横屏时键盘悬浮在应用上方：拖动底部横条移动位置，拖动底部两角调整大小，长按工具栏悬浮按钮可重置。工具栏和“更多”面板也能随时开关</string>
    <string name="floating_keyboard_opacity">悬浮键盘不透明度</string>
    <string name="floating_keyboard_reset_toast">已重置悬浮键盘位置和大小</string>
    <string name="check_update">检查更新</string>
    <string name="check_update_summary">从 GitHub 下载这个修改版的最新版本并安装</string>
</resources>
